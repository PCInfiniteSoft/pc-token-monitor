<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Menu-bar-only app: no Dock icon, no app menu. Set here (not just via
       set_activation_policy in setup) so macOS knows before the app loads and
       the Dock icon never flashes at launch. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
